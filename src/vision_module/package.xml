<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_module</name>
  <version>1.0.0</version>
  <description>Package related to robot vision, implements functions of obtaining emotion estimation, detecting sunlight and shadow and labeling what the robot sees.</description>
  <maintainer email="antonio@mizuuchi.lab.tuat.ac.jp">plantroid</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>plantroid_msgs</depend>
  <depend>opencv-python</depend>
  <depend>python-polylabel</depend>  
  <depend>PIL</depend>
  <depend>socket</depend>
  <depend>seeed_mlx90640</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
