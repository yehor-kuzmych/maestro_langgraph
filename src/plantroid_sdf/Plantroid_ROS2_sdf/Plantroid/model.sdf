<?xml version='1.0'?>
<sdf version='1.4'>
  <model name="Plantroid">
    <static>false</static>
    <link name='chassis'>
      <pose>0 0 .015 0 0 0</pose>
      <mass>5</mass>
      <inertia>
        <ixx>0.0079</ixx>
        <iyy>0.00854</iyy>
        <izz>0.006</izz>
      </inertia>
      <collision name='collision'>
        <pose>0.04 0.1 .0825 0 0 0</pose>
        <geometry>
          <box>
            <size>.275 .42 0.165 </size>
          </box>
        </geometry>
      </collision>

      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://Plantroid/meshes/PlantroidBase.stl</uri>
            <scale>0.00125 0.00125 0.00125</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name='caster_collision'>
        <pose>0.16 0.1025 -.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>.01</radius>
          </sphere>
        </geometry>

        <surface>
          <friction>
            <ode>
            <mu>0</mu>
            <mu2>0</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
          </friction>
        </surface>
      </collision>

      <visual name='caster_visual_cylinder'>
        <pose>0.16 0.1025 -.0125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>.01</radius>
            <length>.02</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name='caster_visual_ball'>
        <pose>0.16 0.1025 -.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>.01</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>-0.024 0.225 0.041 0 1.5707 1.5707</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.06</radius>
            <length>.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://Plantroid/meshes/Wheel.stl</uri>
            <scale>0.00125 0.00125 0.00125</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>-0.024 -.0225 0.041 0 1.5707 1.5707</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.06</radius>
            <length>.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://Plantroid/meshes/Wheel.stl</uri>
            <scale>0.00125 0.00125 0.00125</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="head">
      <pose>0.105 .09 0.295 0 0 0</pose>
      <collision name="collision">
        <pose>0.07 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.045 0.2375 0.19</size>
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://Plantroid/meshes/PlantroidHead.stl</uri>
            <scale>0.00125 0.00125 0.00125</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint type="revolute" name="left_wheel_hinge">
      <pose>0 0 0 0 0 0</pose>
      <child>left_wheel</child>
      <parent>chassis</parent>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint type="revolute" name="right_wheel_hinge">
      <pose>0 0 0 0 0 0</pose>
      <child>right_wheel</child>
      <parent>chassis</parent>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint type="revolute" name="head_hinge">
      <pose>0 .09 0.135 0 0 0</pose>
      <child>head</child>
      <parent>chassis</parent>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
      <dynamics damping="0.0" friction="2000.0" />
    </joint>

    <plugin name="Plantroid_diff_drive" filename="libgazebo_ros_diff_drive.so">

      <ros>
        <!-- <namespace>/tb3</namespace> -->
      </ros>

      <update_rate>30</update_rate>

      <!-- wheels -->
      <left_joint>left_wheel_hinge</left_joint>
      <right_joint>right_wheel_hinge</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.045</wheel_diameter>

      <!-- limits -->
      <max_wheel_torque>1</max_wheel_torque>
      <max_wheel_acceleration>0.1</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

    </plugin>

    <plugin name="Plantroid_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <!-- <namespace>/tb3</namespace> -->
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_hinge</joint_name>
      <joint_name>right_wheel_hinge</joint_name>
      <joint_name>head_hinge</joint_name>
    </plugin>

    <link name="OKAO_Vision_link">
      <pose>0.2 0.08 0.37 0 0 0</pose>
      <inertial>
        <mass>0.000000001</mass>
        <inertia>
          <ixx>0.000166667</ixx>
          <iyy>0.000166667</iyy>
          <izz>0.000166667</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.001 0.03 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.001 0.03 0.03</size>
          </box>
        </geometry>
      </visual>
      <sensor name="camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>0.8726646259971648</horizontal_fov>
          <image>
            <width>240</width>
            <height>320</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        </camera>
        <plugin name="plugin_name" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>plantroid</namespace>
            <remapping>image_raw:=/camera/image_raw</remapping>
            <remapping>camera_info:=/camera/camera_info</remapping>
          </ros>
          <camera_name>hvc-p2</camera_name>
          <frame_name></frame_name>
          <!-- setting hackBaseline to anything but 0.0 will cause a misalignment
                   between the gazebo sensor image and the frame it is supposed to
                   be attached to -->
          <hack_baseline>0.0</hack_baseline>
        </plugin>
      </sensor>
    </link>

    <joint type="fixed" name="camera_joint">
      <pose>0 0 0 0 0 0</pose>
      <child>OKAO_Vision_link</child>
      <parent>head</parent>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

  </model>
</sdf>
