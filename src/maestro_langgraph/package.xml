<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maestro_langgraph</name>
  <version>1.0.0</version>
  <description>LangGraph-based dialogue system for ROOTED robot</description>
  <maintainer email="antonio@mizuuchi.lab.tuat.ac.jp">Antonio Galiza Cerdeira Gonzalez</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>speech_recogntion</depend>
  <depend>uuid</depend>
  <depend>rooted_encoder</depend>
  <depend>rooted_gestures</depend>
  <depend>facial_expression</depend>
  <depend>listening_module</depend>
  <depend>vision_module</depend>
  <depend>std_msgs</depend>
  <depend>rooted_msgs</depend>
  <depend>rooted_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
